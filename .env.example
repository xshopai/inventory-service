PORT=8004

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-dev-secret-key-change-me

# Database Configuration
DATABASE_URL=mysql+pymysql://admin:admin123@localhost:3306/inventory_service_db

# =============================================================================
# MESSAGING CONFIGURATION
# =============================================================================
# Choose ONE messaging provider:
#   - 'dapr'     : Use Dapr sidecar (production-like, config in .dapr/components/)
#   - 'rabbitmq' : Direct RabbitMQ connection (simpler local dev)
#   - 'mock'     : No-op messaging (for testing without infrastructure)
# =============================================================================
MESSAGING_PROVIDER=rabbitmq

# -----------------------------------------------------------------------------
# RabbitMQ Settings (ONLY needed when MESSAGING_PROVIDER=rabbitmq)
# When using Dapr, RabbitMQ connection is configured in .dapr/components/event-bus.yaml
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=inventory-events

# -----------------------------------------------------------------------------
# Dapr Settings (ONLY needed when MESSAGING_PROVIDER=dapr)
# -----------------------------------------------------------------------------
# DAPR_PUBSUB_NAME=event-bus
# DAPR_HTTP_PORT=3504

# -----------------------------------------------------------------------------
# JWT Configuration
# - JWT_SECRET: Required for non-Dapr mode (in Dapr mode, retrieved from Secret Store)
# - Other JWT_* vars: Optional config with sensible defaults, used in BOTH modes
# Must match the JWT configuration used by auth-service
# -----------------------------------------------------------------------------
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=

# Service Tokens - Generate with: openssl rand -hex 12
PRODUCT_SERVICE_TOKEN=svc-product-service-4ff5876fc86cc45a18d88e5d
ORDER_SERVICE_TOKEN=svc-order-service-4ff5876fc86cc45a18d88e5d
CART_SERVICE_TOKEN=svc-cart-service-4ff5876fc86cc45a18d88e5d
WEB_BFF_TOKEN=svc-web-bff-4ff5876fc86cc45a18d88e5d

# Logging
LOG_LEVEL=DEBUG