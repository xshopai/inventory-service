{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Local)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "8005"
      }
    },
    {
      "name": "Debug (with Dapr)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env.dapr",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "8005",
        "DAPR_HTTP_PORT": "3505",
        "DAPR_GRPC_PORT": "50005"
      },
      "preLaunchTask": "dapr-start-inventory",
      "postDebugTask": "dapr-stop-inventory"
    }
  ]
}
