# Inventory Service - Local Development (without Dapr)
# Copy to .env for local development

# Service Configuration
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
FLASK_ENV=development
DB_NAME=inventory_service_db

# Messaging
MESSAGING_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_EXCHANGE=inventory-events

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

# Secrets (hyphenated - Key Vault compatible naming)
# These are read directly as env vars when running without Dapr
xshopai-mysql-server-connection=mysql+pymysql://admin:admin123@localhost:3306
xshopai-jwt-secret=bXktc3VwZXItc2VjcmV0LWtleS1mb3Itand0LXNpZ25pbmc=
xshopai-flask-secret=6a91d5b4e8c347b2a19f0d8c6e3f2b7a4d5c8e1f9a2b6d3c
xshopai-svc-product-token=local-product-service-token
xshopai-svc-order-token=local-order-service-token
xshopai-svc-cart-token=local-cart-service-token
xshopai-svc-webbff-token=local-webbff-service-token

# Optional - Azure Monitor (leave empty for local dev)
xshopai-appinsights-connection=
