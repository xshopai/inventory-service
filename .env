# Service Configuration
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
ENVIRONMENT=development

# Messaging
MESSAGING_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_EXCHANGE=inventory-events

# Distributed Tracing (Zipkin)
# For Dapr local development: localhost:9411 (Dapr's Zipkin)
# For Docker deployment: localhost:9412 (Docker Zipkin container)
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
OTEL_SERVICE_NAME=inventory-service
OTEL_TRACES_EXPORTER=zipkin

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

# Database Connection
MYSQL_SERVER_CONNECTION=mysql+pymysql://admin:admin123@localhost:3306
DB_NAME=inventory_service_db

# Redis Cache (optional)
# For Dapr local development: localhost:6379 (Dapr's Redis)
# For Docker deployment: localhost:6380 (Docker Redis container)
REDIS_URL=redis://localhost:6379

# JWT Configuration (required for non-Dapr mode)
JWT_SECRET=q9X2K8vT1mLpR4sNz7YcHd6Qw3EfUaBjM5tGx0VrCi8=

# Service Tokens (for service-to-service communication)
SERVICE_PRODUCT_TOKEN=prd_8fK29sLmQx7vR2nT5yZc4WpJ1aH6uE
SERVICE_ORDER_TOKEN=ord_Y7mNx3QaP9tLs2Vk8HdR5cBw1Zj4Fe
