# =============================================================================
# Service Configuration
# =============================================================================
# Core service settings for service name, version, port, and environment
# =============================================================================
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
ENVIRONMENT=development

# Service Invocation Mode
SERVICE_INVOCATION_MODE=http

# =============================================================================
# Messaging Configuration
# =============================================================================
# Event-driven messaging settings for RabbitMQ integration
# MESSAGING_PROVIDER: rabbitmq (default) or dapr
# RABBITMQ_URL: Connection string for RabbitMQ broker
# RABBITMQ_EXCHANGE: Exchange name for publishing/consuming events (unified across all services)
# =============================================================================
MESSAGING_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_EXCHANGE=xshopai.events

# =============================================================================
# Distributed Tracing Configuration
# =============================================================================
# OpenTelemetry tracing for distributed request tracking
# OTEL_TRACES_EXPORTER options:
#   - zipkin: Local development with Zipkin (default)
#   - otlp: OpenTelemetry Collector (e.g., Jaeger, Grafana Tempo)
#   - azure: Azure Application Insights
#   - none: Disable tracing
# =============================================================================

# Option 1: Zipkin (Local Development - Default)
OTEL_TRACES_EXPORTER=zipkin
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Option 2: OTLP (OpenTelemetry Collector)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Option 3: Azure Application Insights
# OTEL_TRACES_EXPORTER=azure
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.applicationinsights.azure.com/

# Service name for tracing
OTEL_SERVICE_NAME=inventory-service

# =============================================================================
# Logging Configuration
# =============================================================================
# Structured logging settings
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT: console (human-readable) or json (structured)
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

# =============================================================================
# Database Configuration
# =============================================================================
# MySQL database connection settings
# MYSQL_SERVER_CONNECTION: Full connection string with credentials
# DB_NAME: Database name for inventory data
# =============================================================================
MYSQL_SERVER_CONNECTION=mysql+pymysql://admin:admin123@localhost:3306
DB_NAME=inventory_service_db

# =============================================================================
# JWT Configuration
# =============================================================================
# JSON Web Token settings for authentication
# Required when running without Dapr sidecar
# JWT_SECRET: Secret key for validating JWT tokens from auth-service
# =============================================================================
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform

# =============================================================================
# Service URLs
# =============================================================================
# URLs for external service dependencies
# =============================================================================
PRODUCT_SERVICE_URL=http://localhost:8001

# =============================================================================
# Service-to-Service Authentication Tokens
# =============================================================================
# Pre-shared tokens for secure service-to-service communication
# Used to validate incoming requests from other services
# =============================================================================
PRODUCT_SERVICE_TOKEN=prd_8fK29sLmQx7vR2nT5yZc4WpJ1aH6uE
ORDER_SERVICE_TOKEN=ord_Y7mNx3QaP9tLs2Vk8HdR5cBw1Zj4Fe
CART_SERVICE_TOKEN=crt_T6pLd9XvR3sNm1Qw8KaZ5uHc2Bj7Ye
WEBBFF_SERVICE_TOKEN=bff_W2rTk8LpQ5nVz1Xm9HsDc4Jy6Fa3Ne
