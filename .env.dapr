# Inventory Service - Dapr Development Configuration
# Copy this file to .env for local development with Dapr

PORT=8005

# Flask Configuration
FLASK_ENV=development

# Messaging Configuration - use Dapr pubsub
MESSAGING_PROVIDER=dapr

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

