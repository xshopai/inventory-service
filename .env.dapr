# Inventory Service - Dapr Development Configuration
# Copy to .env for local development with Dapr
# Secrets are loaded from .dapr/secrets.json via Dapr Secret Store

# Service Configuration
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
ENVIRONMENT=development
DB_NAME=inventory_service_db

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# Messaging - use Dapr pubsub
MESSAGING_PROVIDER=dapr

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

# Note: Secrets are retrieved from Dapr secret store (.dapr/secrets.json locally, Key Vault in Azure):
# - MYSQL_SERVER_CONNECTION (MySQL connection URL)
# - JWT_SECRET (JWT signing key)
# - APPINSIGHTS_CONNECTION (Application Insights - empty for local)
# - SERVICE_*_TOKEN (service-to-service auth tokens)
