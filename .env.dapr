# =============================================================================
# Service Configuration
# =============================================================================
# Core service settings for Dapr-enabled deployment
# =============================================================================
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
ENVIRONMENT=development

# Service Invocation Mode
SERVICE_INVOCATION_MODE=dapr

# =============================================================================
# Database Configuration
# =============================================================================
# Database name only - connection string comes from Dapr secret store
# Dapr automatically retrieves credentials securely from configured secret store
# =============================================================================
DB_NAME=inventory_service_db

# =============================================================================
# Dapr Configuration
# =============================================================================
# Dapr sidecar ports and service-to-service communication
# DAPR_HTTP_PORT: HTTP port for Dapr sidecar (default: 3500)
# DAPR_GRPC_PORT: gRPC port for Dapr sidecar (default: 50001)
# DAPR_PRODUCT_SERVICE_APP_ID: App ID for product-service invocation
# =============================================================================
DAPR_HTTP_PORT=3505
DAPR_GRPC_PORT=50005
DAPR_PRODUCT_SERVICE_APP_ID=product-service

# =============================================================================
# Messaging Configuration
# =============================================================================
# Use Dapr pub/sub component for event-driven messaging
# Dapr handles connection to underlying message broker (RabbitMQ)
# =============================================================================
MESSAGING_PROVIDER=dapr

# =============================================================================
# Logging Configuration
# =============================================================================
# Structured logging settings
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT: console (human-readable) or json (structured)
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log