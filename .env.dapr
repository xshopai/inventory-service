# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=inventory-service
VERSION=1.0.0
PORT=8005
ENVIRONMENT=development

# Service Invocation Mode
SERVICE_INVOCATION_MODE=dapr

# =============================================================================
# Messaging Configuration
# =============================================================================
MESSAGING_PROVIDER=dapr
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_EXCHANGE=xshopai.events

# =============================================================================
# Distributed Tracing Configuration
# =============================================================================
# Option 1: Zipkin (Local Development - Default)
OTEL_TRACES_EXPORTER=zipkin
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# Option 2: OTLP (OpenTelemetry Collector)
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Option 3: Azure Application Insights
# OTEL_TRACES_EXPORTER=azure
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.applicationinsights.azure.com/

OTEL_SERVICE_NAME=inventory-service

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/inventory-service.log

# =============================================================================
# Database Configuration
# =============================================================================
MYSQL_SERVER_CONNECTION=mysql+pymysql://admin:admin123@localhost:3306/inventory_service_db
DB_NAME=inventory_service_db

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=8tDBDMcpxroHoHjXjk8xp/uAn8rzD4y8ZZremFkC4gI=
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=xshopai-platform

# =============================================================================
# Service URLs and Dapr App IDs
# =============================================================================
PRODUCT_SERVICE_URL=http://localhost:8001
DAPR_HTTP_PORT=3505
DAPR_GRPC_PORT=50005
DAPR_PRODUCT_SERVICE_APP_ID=product-service

# =============================================================================
# Service-to-Service Authentication Tokens
# =============================================================================
PRODUCT_SERVICE_TOKEN=prd_8fK29sLmQx7vR2nT5yZc4WpJ1aH6uE
ORDER_SERVICE_TOKEN=ord_Y7mNx3QaP9tLs2Vk8HdR5cBw1Zj4Fe
CART_SERVICE_TOKEN=crt_T6pLd9XvR3sNm1Qw8KaZ5uHc2Bj7Ye
WEBBFF_SERVICE_TOKEN=bff_W2rTk8LpQ5nVz1Xm9HsDc4Jy6Fa3Ne

LOG_TO_CONSOLE=true
